{
  "$id": "http://example.com/People",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Investigators and contributors associated with NAMHub studies. Synapse table: syn75404714.",
  "properties": {
    "Email": {
      "description": "Contact email address.",
      "pattern": "^[^@]+@[^@]+\\.[^@]+$",
      "title": "Email",
      "type": "string"
    },
    "FirstName": {
      "description": "First name.",
      "title": "First Name",
      "type": "string"
    },
    "GrantId": {
      "description": "Grant identifier linking to the Grants table (syn75404715).",
      "title": "Grant_id",
      "type": "string"
    },
    "Institution": {
      "description": "Affiliated institution(s).",
      "items": {
        "type": "string"
      },
      "title": "Institution",
      "type": "array"
    },
    "InvestigatorId": {
      "description": "Unique identifier for the investigator.",
      "title": "Investigator_id",
      "type": "string"
    },
    "LastName": {
      "description": "Last name.",
      "title": "Last Name",
      "type": "string"
    },
    "OrcidId": {
      "description": "ORCID persistent digital identifier.",
      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
      "title": "Orcid_id",
      "type": "string"
    },
    "PortalDisplay": {
      "description": "Whether this record should be displayed on the public portal.",
      "title": "Portal Display",
      "type": "boolean"
    },
    "Role": {
      "description": "Role in the NAMHub program.",
      "enum": [
        "Principal Investigator",
        "Co-Investigator",
        "Collaborator",
        "Coordinating Center",
        "Trainee",
        "Other"
      ],
      "title": "Role"
    },
    "StudyId": {
      "description": "Study identifier linking to the Studies table (syn75404711).",
      "title": "Study_id",
      "type": "string"
    },
    "SynapseId": {
      "description": "Synapse user account ID.",
      "title": "Synapse_id",
      "type": "string"
    }
  },
  "required": [
    "FirstName",
    "LastName"
  ],
  "title": "People",
  "type": "object"
}