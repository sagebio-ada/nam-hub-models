{
  "$id": "http://example.com/People",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Investigators and contributors associated with NAMHub studies. Synapse table: syn75404714.",
  "properties": {
    "Email": {
      "description": "Contact email address.",
      "pattern": "^[^@]+@[^@]+\\.[^@]+$",
      "title": "email",
      "type": "string"
    },
    "FirstName": {
      "description": "First name.",
      "title": "firstName",
      "type": "string"
    },
    "GrantId": {
      "description": "Grant identifier linking to the Grants table (syn75404715).",
      "title": "grantId",
      "type": "string"
    },
    "Institution": {
      "description": "Affiliated institution(s).",
      "items": {
        "type": "string"
      },
      "title": "institution",
      "type": "array"
    },
    "InvestigatorId": {
      "description": "Unique identifier for the investigator.",
      "title": "investigatorId",
      "type": "string"
    },
    "LastName": {
      "description": "Last name.",
      "title": "lastName",
      "type": "string"
    },
    "OrcidId": {
      "description": "ORCID persistent digital identifier.",
      "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$",
      "title": "orcidId",
      "type": "string"
    },
    "PortalDisplay": {
      "description": "Whether this record should be displayed on the public portal.",
      "title": "portalDisplay",
      "type": "boolean"
    },
    "Role": {
      "description": "Role in the NAMHub program.",
      "enum": [
        "Co-Investigator",
        "Collaborator",
        "DataManager",
        "Other",
        "PrincipalInvestigator",
        "Trainee"
      ],
      "title": "role"
    },
    "StudyId": {
      "description": "Study identifier linking to the Studies table (syn75404711).",
      "title": "studyId",
      "type": "string"
    },
    "SynapseUserId": {
      "description": "Synapse user account ID.",
      "title": "synapseUserId",
      "type": "string"
    }
  },
  "required": [
    "FirstName",
    "GrantId",
    "LastName",
    "StudyId"
  ],
  "title": "People",
  "type": "object"
}