{
  "$id": "http://example.com/Grants",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Backend grant records linked to Studies. Not directly surfaced on the portal. Synapse table: syn75404715.",
  "properties": {
    "Abstract": {
      "description": "Grant abstract.",
      "title": "Abstract",
      "type": "string"
    },
    "FundingAgency": {
      "description": "Funding agency or agencies (e.g. NIH Common Fund).",
      "items": {
        "type": "string"
      },
      "title": "Funding Agency",
      "type": "array"
    },
    "GrantId": {
      "description": "Grant identifier linking to the Grants table (syn75404715).",
      "title": "Grant_id",
      "type": "string"
    },
    "GrantInstitution": {
      "description": "Institution holding the grant.",
      "title": "Grant Institution",
      "type": "string"
    },
    "GrantName": {
      "description": "Full title of the grant.",
      "title": "Grant Name",
      "type": "string"
    },
    "GrantNumber": {
      "description": "NIH grant number (e.g. UM1TR006029).",
      "title": "Grant Number",
      "type": "string"
    },
    "GrantType": {
      "description": "Grant mechanism type (e.g. UM1, R01).",
      "title": "Grant Type",
      "type": "string"
    },
    "Investigator": {
      "description": "Name of the principal investigator.",
      "title": "Investigator",
      "type": "string"
    },
    "NihReporterLink": {
      "description": "URL to the grant record on NIH Reporter.",
      "format": "uri",
      "title": "Nih Reporter Link",
      "type": "string"
    }
  },
  "required": [
    "GrantId"
  ],
  "title": "Grants",
  "type": "object"
}