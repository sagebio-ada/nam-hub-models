{
  "$id": "http://example.com/Grants",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Backend grant records linked to Studies. Not directly surfaced on the portal. Synapse table: syn75404715.",
  "properties": {
    "Abstract": {
      "description": "Grant abstract.",
      "title": "abstract",
      "type": "string"
    },
    "FundingAgency": {
      "description": "Funding agency or agencies (e.g. NIH Common Fund).",
      "items": {
        "type": "string"
      },
      "title": "fundingAgency",
      "type": "array"
    },
    "GrantEndDate": {
      "description": "Grant end date.",
      "format": "date",
      "title": "grantEndDate",
      "type": "string"
    },
    "GrantId": {
      "description": "Grant identifier linking to the Grants table (syn75404715).",
      "title": "grantId",
      "type": "string"
    },
    "GrantInstitution": {
      "description": "Institution holding the grant.",
      "title": "grantInstitution",
      "type": "string"
    },
    "GrantName": {
      "description": "Full title of the grant.",
      "title": "grantName",
      "type": "string"
    },
    "GrantNumber": {
      "description": "NIH grant number (e.g. UM1TR006029).",
      "title": "grantNumber",
      "type": "string"
    },
    "GrantStartDate": {
      "description": "Grant start date.",
      "format": "date",
      "title": "grantStartDate",
      "type": "string"
    },
    "GrantType": {
      "description": "Grant mechanism type (e.g. UM1, R01).",
      "title": "grantType",
      "type": "string"
    },
    "Investigator": {
      "description": "Name of the principal investigator.",
      "title": "investigator",
      "type": "string"
    },
    "NihReporterLink": {
      "description": "URL to the grant record on NIH Reporter.",
      "format": "uri",
      "title": "nihReporterLink",
      "type": "string"
    }
  },
  "required": [
    "GrantId"
  ],
  "title": "Grants",
  "type": "object"
}