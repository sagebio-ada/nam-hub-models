{# Shared enum-rendering macros.

   Used by both enum.md.jinja2 (the standalone enum page) and slot.md.jinja2
   (which inlines the permissible values of any enum-ranged slot).

   `gen` is passed in explicitly rather than relied upon from the surrounding
   context: templates receive `gen`/`schemaview`/`element` as render-time
   context variables, and a macro imported without `with context` does not see
   them. The `enshorten` filter is registered on the Jinja environment, so it
   remains available inside the macro. #}

{# Render an enum's permissible values as a Markdown table, or the
   "dynamic enum" note when the enum has no enumerated values.
   `enum` is an EnumDefinition; `gen` is the DocGenerator. #}
{% macro permissible_values_table(enum, gen) -%}
{%- if enum.permissible_values -%}
{%- set has_pv_extras = namespace(found=false) -%}
{%- for pv in enum.permissible_values.values() -%}
  {%- if pv.title or pv.is_a or pv.mixins or pv.deprecated -%}
    {%- set has_pv_extras.found = true -%}
  {%- endif -%}
{%- endfor -%}
{%- if has_pv_extras.found %}
| Value | Meaning | Description | Additional Info |
| --- | --- | --- | --- |
{% for pv in enum.permissible_values.values() -%}
| {{ pv.text }} | {{ pv.meaning }} | {{ pv.description|enshorten }} |
{%- if pv.title %} Title: {{ pv.title }}<br>{% endif -%}
{%- if pv.is_a %} Is-A: {{ gen.link(pv.is_a) }}<br>{% endif -%}
{%- if pv.mixins %} Mixins: {{ gen.links(pv.mixins) | join(', ') }}<br>{% endif -%}
{%- if pv.deprecated %} **DEPRECATED**{% if pv.deprecated_element_has_exact_replacement %} (use {{ gen.link(pv.deprecated_element_has_exact_replacement) }}){% endif %}{% endif -%}
 |
{% endfor %}
{%- else %}
| Value | Meaning | Description |
| --- | --- | --- |
{% for pv in enum.permissible_values.values() -%}
| {{ pv.text }} | {{ pv.meaning }} | {{ pv.description|enshorten }} |
{% endfor %}
{%- endif %}
{%- else %}
_This is a dynamic enum_
{%- endif %}
{%- endmacro %}
